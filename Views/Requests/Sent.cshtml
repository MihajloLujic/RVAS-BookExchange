@model List<RVAS_BookExchange.Models.BookRequest>
@{
    ViewData["Title"] = "Poslati zahtevi";
}

<div class="container py-4">
    <h2 style="font-family:'Playfair Display',serif; margin-bottom:24px;">Moji poslati zahtevi</h2>

    @if (Model == null || !Model.Any())
    {
        <p style="opacity:0.7;">Još uvek niste poslali nijedan zahtev.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-3" style="max-width:700px;">
            @foreach (var request in Model)
            {
                <div style="background-color:var(--bg-input); border-radius:16px; padding:24px;">
                    <h5 style="font-weight:700; margin-bottom:12px;">Zahtev za: @request.BookTitle</h5>
                    <p style="font-size:0.9rem; margin-bottom:4px;"><strong>Tip:</strong> @request.RequestType</p>
                    <p style="font-size:0.9rem; margin-bottom:4px;">
                        <strong>Status:</strong>
                        <span class="@(request.Status == "Pending" ? "badge-pending" : request.Status == "Accepted" ? "badge-accepted" : "badge-rejected")">
                            @request.Status
                        </span>
                    </p>
                    <p style="font-size:0.85rem; opacity:0.7; margin-bottom:8px;">@request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>

                    @if (!string.IsNullOrWhiteSpace(request.ResponseComment))
                    {
                        <p style="font-size:0.9rem; margin-bottom:4px;"><strong>Komentar vlasnika:</strong> @request.ResponseComment</p>
                    }

                    @if (request.RespondedAt != null)
                    {
                        <p style="font-size:0.85rem; opacity:0.7;">Odgovoreno: @request.RespondedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                    }
                </div>
            }
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Books" asp-action="Index" class="btn-raf-outline">Nazad na knjige</a>
    </div>
</div>