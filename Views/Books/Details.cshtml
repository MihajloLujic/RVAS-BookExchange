@model RVAS_BookExchange.Models.BookListing
@{
    ViewData["Title"] = "Detalji knjige";
}

<div class="container py-4">
    <p style="font-weight:700; font-size:0.95rem; margin-bottom:20px;">
        @Model.Genre
    </p>

    <div class="row g-4">
        <div class="col-md-3">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="@Model.Title" style="width:100%; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,0.15);" />
            }
            else
            {
                <div style="width:100%; height:380px; background-color:var(--bg-input); border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:4rem;">
                    📚
                </div>
            }

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <form asp-controller="Requests" asp-action="Create" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookListingId" value="@Model.Id" />
                    <button type="submit" style="width:100%; background-color:var(--bg-input); border:none; border-radius:30px; padding:14px 24px; font-weight:700; font-size:0.95rem; cursor:pointer;">
                        Pozajmi / razmijeni knjigu
                    </button>
                </form>
            }
        </div>

        <div class="col-md-6">
            <h1 style="font-family:'Playfair Display',serif; font-size:2rem; font-weight:700; margin-bottom:6px;">
                @Model.Title
            </h1>
            <p style="font-size:1.1rem; font-weight:700; color:var(--btn-primary); margin-bottom:24px;">
                @Model.Author
            </p>

            <p style="font-weight:700; font-size:1rem; border-bottom:1px solid var(--text-dark); padding-bottom:6px; margin-bottom:12px;">
                O knjizi
            </p>
            <p style="font-size:0.9rem; line-height:1.7; opacity:0.85; margin-bottom:16px;">
                @Model.Description
            </p>

            <p style="font-size:0.85rem; opacity:0.7;">
                Stanje: <strong>@Model.Condition</strong>
            </p>
            @if (!string.IsNullOrEmpty(Model.ConditionDescription))
            {
                <p style="font-size:0.85rem; opacity:0.7;">@Model.ConditionDescription</p>
            }
        </div>

        <div class="col-md-3 text-center">
            <p style="font-weight:700; font-size:1rem; margin-bottom:4px;">Lokacija</p>
            <p style="font-size:1rem; font-weight:700; color:var(--btn-primary); margin-bottom:24px;">@Model.City</p>

            <svg width="80" height="60" viewBox="0 0 80 60" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.3;">
                <rect x="5" y="10" width="20" height="40" rx="2" />
                <rect x="30" y="5" width="20" height="45" rx="2" />
                <rect x="55" y="15" width="20" height="35" rx="2" />
            </svg>

            <div class="mt-3">
                <p style="font-size:0.85rem; opacity:0.7;">Vlasnik</p>
                <p style="font-size:0.9rem; font-weight:700;">@Model.OwnerEmail</p>
            </div>
        </div>
    </div>
</div>