@using System.Security.Claims
@model RVAS_BookExchange.Models.BookListing

<h2>Detalji knjige</h2>

<div>
    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
    {
        <img src="@Model.ImagePath" alt="Slika knjige" style="width: 250px; height: auto;" />
    }

    <h3>@Model.Title</h3>

    <p>
        <strong>Autor:</strong> @Model.Author
    </p>

    <p>
        <strong>Žanr:</strong> @Model.Genre
    </p>

    <p>
        <strong>Stanje:</strong> @Model.Condition
    </p>

    <p>
        <strong>Opis knjige i oglasa:</strong>
        <br />
        @Model.Description
    </p>

    <p>
        <strong>Opis stanja knjige:</strong>
        <br />
        @Model.ConditionDescription
    </p>

    <p>
        <strong>Grad / lokacija:</strong> @Model.City
    </p>

    <p>
        <strong>Vlasnik oglasa:</strong> @Model.OwnerEmail
    </p>

    <p>
        <strong>Datum objave:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
    </p>

    <p>
        <strong>Poslednja izmena:</strong> @Model.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
    </p>
</div>
<hr />

@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    if (Model.OwnerUserId != currentUserId)
    {
        <h3>Pošalji zahtev</h3>

        <form asp-controller="Requests" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="bookId" value="@Model.Id" />

            <div>
                <label>Tip zahteva</label>
                <select name="requestType" required>
                    <option value="">-- Izaberi tip zahteva --</option>
                    <option value="Pozajmljivanje">Pozajmljivanje</option>
                    <option value="Razmena">Razmena</option>
                </select>
            </div>

            <button type="submit">Pošalji zahtev</button>
        </form>
        <hr />

        <h3>Poruka vlasniku</h3>

        <form asp-controller="Messages" asp-action="Start" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="bookId" value="@Model.Id" />

            <button type="submit">Pošalji poruku vlasniku</button>
        </form>
    }
    else
    {
        <p>Ovo je vaš oglas, ne možete poslati zahtev za sopstvenu knjigu.</p>
    }
}
else
{
    <p>
        Morate biti prijavljeni da biste poslali zahtev.
        <a asp-controller="Account" asp-action="Login">Prijavite se</a>
    </p>
}

<a asp-controller="Books" asp-action="Index">Nazad na dostupne knjige</a>