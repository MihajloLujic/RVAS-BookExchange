@model RVAS_BookExchange.Models.BookListing

<h2>Detalji knjige</h2>

<div>
    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
    {
        <img src="@Model.ImagePath" alt="Slika knjige" style="width: 250px; height: auto;" />
    }

    <h3>@Model.Title</h3>

    <p>
        <strong>Autor:</strong> @Model.Author
    </p>

    <p>
        <strong>Žanr:</strong> @Model.Genre
    </p>

    <p>
        <strong>Stanje:</strong> @Model.Condition
    </p>

    <p>
        <strong>Opis knjige i oglasa:</strong>
        <br />
        @Model.Description
    </p>

    <p>
        <strong>Opis stanja knjige:</strong>
        <br />
        @Model.ConditionDescription
    </p>

    <p>
        <strong>Grad / lokacija:</strong> @Model.City
    </p>

    <p>
        <strong>Vlasnik oglasa:</strong> @Model.OwnerEmail
    </p>

    <p>
        <strong>Datum objave:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
    </p>

    <p>
        <strong>Poslednja izmena:</strong> @Model.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
    </p>
</div>

<a asp-controller="Books" asp-action="Index">Nazad na dostupne knjige</a>