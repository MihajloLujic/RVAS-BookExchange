@model RVAS_BookExchange.ViewModels.BookListViewModel
@{
    ViewData["Title"] = "Dostupne knjige";
}

<div class="container-fluid px-4 py-4">
    <h2 class="mb-4" style="font-family: 'Playfair Display', serif;">Dostupne knjige</h2>

    <div class="row mb-4">
        <div class="col-12">
            <form method="get" asp-action="Index" class="d-flex flex-wrap gap-2">
                <input name="title" value="@Model.Title" placeholder="Naslov..." class="form-control-raf" style="width:200px;" />
                <input name="author" value="@Model.Author" placeholder="Autor..." class="form-control-raf" style="width:200px;" />
                <select name="genre" class="form-control-raf" style="width:180px;">
                    <option value="">Svi žanrovi</option>
                    @foreach (var zanr in new[] { "Roman", "Naučna fantastika", "Istorija", "Biografija", "Poezija", "Detektivski", "Fantazija", "Drama" })
                    {
                        <option value="@zanr" selected="@(Model.Genre == zanr)">@zanr</option>
                    }
                </select>
                <input name="city" value="@Model.City" placeholder="Grad..." class="form-control-raf" style="width:160px;" />
                <button type="submit" class="btn-raf">Pretraži</button>
                <a asp-action="Index" class="btn-raf-outline">Resetuj</a>
            </form>
        </div>
    </div>

    @if (!Model.Books.Any())
    {
        <div class="text-center py-5">
            <p style="font-size:1.1rem; opacity:0.7;">Nema knjiga za prikaz.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
            @foreach (var knjiga in Model.Books)
            {
                <div class="col">
                    <div class="book-card">
                        @if (!string.IsNullOrEmpty(knjiga.ImagePath))
                        {
                            <img src="@knjiga.ImagePath" alt="@knjiga.Title" />
                        }
                        else
                        {
                            <div class="no-image">📚</div>
                        }
                        <div class="book-title">@knjiga.Title</div>
                        <div class="book-author">@knjiga.Author</div>
                        <div class="book-owner">Vlasnik: @knjiga.OwnerEmail</div>
                        <a asp-action="Details" asp-route-id="@knjiga.Id" class="btn-raf mt-2" style="font-size:0.85rem; padding: 7px 18px;">Detalji</a>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-title="@Model.Title" asp-route-author="@Model.Author" asp-route-genre="@Model.Genre" asp-route-city="@Model.City">&#8249;</a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i <= 4 || i > Model.TotalPages - 2 || Math.Abs(i - Model.CurrentPage) <= 1)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-title="@Model.Title" asp-route-author="@Model.Author" asp-route-genre="@Model.Genre" asp-route-city="@Model.City">@i</a>
                            </li>
                        }
                        else if (i == 5 || i == Model.TotalPages - 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-title="@Model.Title" asp-route-author="@Model.Author" asp-route-genre="@Model.Genre" asp-route-city="@Model.City">&#8250;</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>