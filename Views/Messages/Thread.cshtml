@using System.Security.Claims
@model RVAS_BookExchange.Models.Conversation

<h2>Razgovor za knjigu: @Model.BookTitle</h2>

<a asp-controller="Messages" asp-action="Index">Nazad na poruke</a>

<hr />

@if (Model.Messages == null || !Model.Messages.Any())
{
    <p>Još uvek nema poruka u ovom razgovoru.</p>
}
else
{
    <div>
        @foreach (var message in Model.Messages.OrderBy(m => m.SentAt))
        {
            var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
            var isMyMessage = message.SenderUserId == currentUserId;

            <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;">
                <p>
                    <strong>@(isMyMessage ? "Vi" : message.SenderEmail)</strong>
                    <span>
                        @message.SentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </span>
                </p>

                <p>@message.Text</p>
            </div>
        }
    </div>
}

<hr />

<h3>Pošalji novu poruku</h3>

<form asp-controller="Messages" asp-action="Send" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="conversationId" value="@Model.Id" />

    <div>
        <label>Poruka</label>
        <textarea name="text" required></textarea>
    </div>

    <button type="submit">Pošalji</button>
</form>