@using System.Security.Claims
@model RVAS_BookExchange.Models.Conversation
@{
    ViewData["Title"] = "Razgovor";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container py-4" style="max-width:700px;">
    <a asp-controller="Messages" asp-action="Index" class="btn-raf-outline mb-4 d-inline-block">&#8249; Nazad na poruke</a>

    <h2 style="font-family:'Playfair Display',serif; margin-bottom:24px;">@Model.BookTitle</h2>

    <div class="chat-container mb-4">
        @if (Model.Messages == null || !Model.Messages.Any())
        {
            <p style="opacity:0.7; text-align:center;">Još nema poruka. Započnite razgovor!</p>
        }
        else
        {
            @foreach (var message in Model.Messages.OrderBy(m => m.SentAt))
            {
                var isMyMessage = message.SenderUserId == currentUserId;
                <div class="@(isMyMessage ? "chat-bubble-mine" : "chat-bubble-theirs")">
                    <div>@message.Text</div>
                    <div style="font-size:0.75rem; opacity:0.65; margin-top:4px;">
                        @(isMyMessage ? "Vi" : message.SenderEmail) · @message.SentAt.ToLocalTime().ToString("HH:mm")
                    </div>
                </div>
            }
        }
    </div>

    <form method="post" asp-controller="Messages" asp-action="Send">
        @Html.AntiForgeryToken()
        <input type="hidden" name="conversationId" value="@Model.Id" />
        <div class="d-flex gap-2">
            <input type="text" name="text" class="form-control-raf" placeholder="Napišite poruku..." style="flex:1;" required />
            <button type="submit" class="btn-raf px-4">Pošalji</button>
        </div>
    </form>
</div>