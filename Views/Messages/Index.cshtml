@model List<RVAS_BookExchange.Models.Conversation>
@{
    ViewData["Title"] = "Poruke";
}

<div class="container py-4">
    <h2 style="font-family:'Playfair Display',serif; margin-bottom:24px;">Poruke</h2>

    @if (Model == null || !Model.Any())
    {
        <p style="opacity:0.7;">Trenutno nemate nijedan razgovor.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-3" style="max-width:700px;">
            @foreach (var conversation in Model)
            {
                <a asp-controller="Messages" asp-action="Thread" asp-route-id="@conversation.Id"
                   style="background-color:var(--bg-input); border-radius:16px; padding:20px; text-decoration:none; color:var(--text-dark); display:block;">
                    <div style="font-weight:700; font-size:0.95rem;">@conversation.BookTitle</div>
                    <div style="font-size:0.82rem; opacity:0.7; margin-top:4px;">
                        Broj poruka: @conversation.Messages.Count · @conversation.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </div>
                    @if (conversation.Messages.Any())
                    {
                        var lastMessage = conversation.Messages.OrderByDescending(m => m.SentAt).First();
                        <div style="font-size:0.85rem; margin-top:8px; opacity:0.8;">@lastMessage.Text</div>
                    }
                </a>
            }
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Books" asp-action="Index" class="btn-raf-outline">Nazad na knjige</a>
    </div>
</div>